# Copy to .env and fill in values as we complete each setup step.

# Worker
# POLL_INTERVAL_MS — how often Gmail email skills are polled when gmail-poll skill is enabled (default 10 min).
# Scheduled skills (focus, morning, heartbeat, dev-runner) run on SCHEDULE_CRON instead.
# PROCESSED_MESSAGE_ID_LIMIT=1000
POLL_INTERVAL_MS=600000
# Cron pattern for scheduled skills (default: every minute).
# SCHEDULE_CRON=* * * * *
# Suppresses email bill + heartbeat Telegram; companion briefings (morning, focus, life) still send.
DRY_RUN=true
LOG_LEVEL=info

# Gmail (Google Cloud OAuth — worker bill polling; separate from MCP below)
# Set client id/secret, then: npm run auth:gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me

# Telegram notifications (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Assistant (OpenAI-compatible API)
OPENAI_API_KEY=
# ASSISTANT_MODEL=gpt-4o-mini
# ASSISTANT_MAX_TOKENS=120          # default companion reply cap (voice-friendly)
# ASSISTANT_PLAN_MAX_TOKENS=280     # when Devin asks for a plan/steps/breakdown
# ASSISTANT_TEMPERATURE=0.85
# OPENAI_BASE_URL=https://api.openai.com/v1

# Mem0 memory (https://github.com/mem0ai/mem0)
# Default: local OSS store in data/mem0/ using OPENAI_API_KEY
MEM0_ENABLED=true
# MEM0_API_KEY=              # optional — use Mem0 Platform instead of local OSS
# MEM0_HOST=https://api.mem0.ai
# MEM0_LLM_MODEL=gpt-4o-mini
# MEM0_EMBED_MODEL=text-embedding-3-small
# SAG_USER_ID=               # optional override for memory user id (default: telegram chat id)
# CONVERSATION_MAX_MESSAGES=24

# Agent reflection (distills activity log into Mem0 agent memories)
REFLECTION_ENABLED=true
# REFLECTION_HOURS=13,21
# REFLECTION_TIMEZONE=America/New_York
# SAG_AGENT_ID=sag

# Heartbeat (optional overrides — defaults are daily)
# HEARTBEAT_REPORT_INTERVAL_MS=86400000
# HEARTBEAT_STALE_AFTER_MS=86400000
# HEARTBEAT_ALERT_COOLDOWN_MS=86400000

# Morning briefing (7:30 AM conversation starter)
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_TIME=07:30
MORNING_BRIEFING_TIMEZONE=America/New_York

# Focus companion (Phase 1: 3 LLM anchors at 8 AM, 1 PM, 9 PM)
FOCUS_COMPANION_ENABLED=true
FOCUS_TIMEZONE=America/New_York
FOCUS_ANCHOR_HOURS=8,13,21
FOCUS_ACTIVE_START_HOUR=8
FOCUS_ACTIVE_END_HOUR=21
FOCUS_HOURLY=false

# Life companion (random personal texts, separate from focus anchors)
LIFE_COMPANION_ENABLED=true
# LIFE_COMPANION_DAILY_CAP=5
# LIFE_COMPANION_MIN_GAP_MINUTES=90
# LIFE_COMPANION_WINDOW_START=8
# LIFE_COMPANION_WINDOW_END=22
# LIFE_COMPANION_SLOT_WINDOW_MINUTES=5

# Autonomous dev (Option D: orchestrator + Cursor Cloud)
DEV_RUNNER_ENABLED=false
# DEV_ORCHESTRATOR_MODE=cursor
# DEV_AUTO_MERGE=true
# GITHUB_REPO=masond84/sag-agent
# LINEAR_API_KEY=
# LINEAR_TEAM_KEY=SAG
# LINEAR_PROJECT=SAG Agent
# CURSOR_API_KEY=
# DEV_CLOUD_MODEL=composer-2.5
# DEV_CLOUD_TIMEOUT_MS=1800000
# DEV_CLOUD_POLL_MS=15000
# DEV_AUDIT_INTERVAL_MS=21600000
# DEV_RUN_TIMEOUT_MS=1800000
# DEV_SELF_RESTART=true

# Post-merge refresh (pull main, rebuild worker + House)
# DEV_HOUSE_BUILD=true
# DEV_HOUSE_RESTART=true
# HOUSE_UI_PORT=3000

# SAG House (optional local web UI — see house/README.md)
# HOUSE_SERVER_ENABLED=false
# HOUSE_SERVER_HOST=127.0.0.1
# HOUSE_SERVER_PORT=9473
# HOUSE_SPEECH_MAX_CHARS=320

# Tier 3 photoreal face (LiveKit + Simli — see livekit-agent/README.md)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=sag-face-agent
# FACE_AVATAR_PROVIDER=simli
# FACE_SESSION_COOLDOWN_MS=20000
# FACE_SESSION_REUSE_MAX_AGE_MS=7200000

# MCP connectors (assistant tools via stdio child processes — see config/mcp-servers.yaml)
MCP_ENABLED=true
# MCP_CONFIG_PATH=config/mcp-servers.yaml
# MCP_RESULT_MAX_CHARS=8000
# Gmail MCP auth: copy OAuth client JSON to data/gmail-mcp/gcp-oauth.keys.json then npm run mcp:gmail-auth
# Calendar MCP auth: enable Calendar API, then npm run mcp:calendar-auth (reuses gcp-oauth.keys.json)

# Income API Services (paid API product stream)
INCOME_SERVICES_ENABLED=true
INCOME_WEEKLY_GOAL=200
# INCOME_REPORT_INTERVAL_HOURS=24

# Content engine (video/social draft factory — see docs/CONTENT_ENGINE.md)
CONTENT_ENGINE_ENABLED=true
CONTENT_EPISODES_PER_DAY=1
CONTENT_MAX_IN_FLIGHT=1
CONTENT_WEEKLY_POST_GOAL=3
# CONTENT_SERIES=sleep-stories,scary-tales,storytime
# Manus/Higgsfield worker — https://open.manus.ai/docs/v2/introduction
# Create key: Manus webapp → Settings → Integrations → Create API Key
MANUS_ENABLED=true
# MANUS_API_KEY=   # required for automated tasks (x-manus-api-key)
# MANUS_API_URL=https://api.manus.ai

# Free tries per visitor/day on the public tools page (/tools)
# INCOME_FREE_DAILY_LIMIT=5
# Stripe billing — required for paid API credits (see README "Payment Processing")
# 1. dashboard.stripe.com → Developers → API keys → Secret key (sk_test_... for test mode)
STRIPE_SECRET_KEY=
# 2. Developers → Webhooks → Add endpoint → http://localhost:9473/api/billing/webhook
#    Event: checkout.session.completed → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Public base URL for checkout redirects (defaults to house server URL)
# BILLING_BASE_URL=http://localhost:9473
# Optional JSON override for credit packs: [{"id":"starter","name":"Starter","description":"$10 API credits","amountCents":1000,"credits":10}]
# STRIPE_CREDIT_PACKS=

# --- Tier 2: API arbitrage (wholesale keys, resold at markup) ---
# Translation (DeepL). Free tier at https://www.deepl.com/pro-api — free keys end with :fx
# and automatically use the free API host. Paid keys use the pro host.
# DEEPL_API_KEY=
# Transcription (Whisper) reuses OPENAI_API_KEY above — no extra key needed.
# Email verification (AbstractAPI) — https://www.abstractapi.com/email-verification-api
# EMAIL_VERIFY_API_KEY=
# Estimated weekly agent operating cost (LLM API, memory, misc) for self-funding tracking.
# The income report shows whether API revenue covers this before chasing the weekly goal.
# AGENT_WEEKLY_COST_USD=25


# Z-Sync: shared Muse<->SAG state loop (z-sync/ directory + scheduled skill).
# ZSYNC_ENABLED=true
# ZSYNC_TIMEZONE=America/New_York
# ZSYNC_DIGEST_TIME=08:00
# Days before a due date that an unpaid bill triggers an alert.
# ZSYNC_BILL_ALERT_DAYS=3
